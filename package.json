{
  "name": "moduleresume",
  "version": "0.2.3",
  "private": true,
  "description": "moduleResume · 模块化简历工作台（Node.js 本地服务 + 浏览器界面，可打包 EXE）",
  "license": "Apache-2.0",
  "main": "desktop/main.js",
  "bin": "run.js",
  "scripts": {
    "start": "node run.js",
    "desktop": "electron .",
    "build": "node scripts/build_exe.js",
    "build:desktop": "node scripts/build_desktop.js",
    "build:installer": "node scripts/build_installer.js",
    "build:all": "node scripts/build_all.js"
  },
  "pkg": {
    "assets": [
      "frontend/**/*"
    ],
    "targets": [
      "node22-win-x64"
    ],
    "outputPath": "dist"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.23.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  }
}
